Package: cWise
Type: Package 
Title: Crosswise Models for Sensitive Survey Questions
Version: 0.1.0
Authors@R: c(
    person("Yuki", "Atsusaka", email = "atsusaka@uh.edu",
           role = c("aut", "cre")),
    person("Kolbe", "Dumas", email = "kdumas@uh.edu",
